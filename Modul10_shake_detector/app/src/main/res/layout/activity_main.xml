<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#1a1a2e">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔊 Shake Detector"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Guncang smartphone untuk memicu alarm!"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:layout_marginBottom="32dp" />

    <!-- Accelerometer Values Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="20dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📊 Accelerometer Data"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/AccelerometerXTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="X: 0.00 m/s²"
            android:textColor="#FF6B6B"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/AccelerometerYTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Y: 0.00 m/s²"
            android:textColor="#4ECDC4"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/AccelerometerZTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Z: 0.00 m/s²"
            android:textColor="#45B7D1"
            android:textSize="16sp"
            android:fontFamily="monospace" />

    </LinearLayout>

    <!-- Status -->
    <TextView
        android:id="@+id/StatusTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: Menunggu guncangan..."
        android:textColor="#4CAF50"
        android:textSize="18sp"
        android:layout_marginBottom="32dp" />

    <!-- Warning Alert -->
    <TextView
        android:id="@+id/WarningTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📱 SHAKE TERDETEKSI! 📱"
        android:textColor="#FFFFFF"
        android:background="#FF0000"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone" />

    <!-- Instructions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="32dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡 Cara Penggunaan:"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Guncang smartphone dengan kuat untuk\nmemicu alarm dan getaran!"
            android:textColor="#888888"
            android:textSize="14sp"
            android:gravity="center" />

    </LinearLayout>

</LinearLayout>
